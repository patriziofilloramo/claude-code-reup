{
  "name": "reup-vscode",
  "displayName": "Reup for Claude Code",
  "description": "Find, understand, and safely resume Claude Code sessions across every project.",
  "version": "0.6.0",
  "publisher": "reup-local",
  "private": true,
  "icon": "media/reup-brand.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/patriziofilloramo/claude-code-reup.git"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "sessions",
    "resume",
    "dashboard"
  ],
  "galleryBanner": {
    "color": "#101315",
    "theme": "dark"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onCommand:reup.diagnostics",
    "onCommand:reup.focusCockpit",
    "onCommand:reup.openSessionDetail",
    "onCommand:reup.openDashboard",
    "onCommand:reup.refreshSessions",
    "onCommand:reup.resumeHere",
    "onCommand:reup.resumeSession",
    "onCommand:reup.searchSessions",
    "onCommand:reup.findTouchedFile",
    "onCommand:reup.showAllProjects",
    "onCommand:reup.showWorkspaceOnly",
    "onCommand:reup.tree.copyHandoff",
    "onCommand:reup.tree.copySessionId",
    "onCommand:reup.tree.editAlias",
    "onCommand:reup.tree.editTags",
    "onCommand:reup.tree.resumeSession",
    "onCommand:reup.tree.revealProjectFolder",
    "onCommand:reup.tree.toggleArchive",
    "onView:reup.sessions",
    "onView:reup.inspector"
  ],
  "contributes": {
    "commands": [
      {
        "command": "reup.openDashboard",
        "title": "Reup: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "reup.diagnostics",
        "title": "Reup: Diagnostics"
      },
      {
        "command": "reup.focusCockpit",
        "title": "Reup: Focus Workspace Cockpit"
      },
      {
        "command": "reup.refreshSessions",
        "title": "Reup: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "reup.resumeHere",
        "title": "Reup: Resume Here",
        "icon": "$(play)"
      },
      {
        "command": "reup.resumeSession",
        "title": "Reup: Resume Session",
        "icon": "$(history)"
      },
      {
        "command": "reup.searchSessions",
        "title": "Reup: Search Sessions",
        "icon": "$(search)"
      },
      {
        "command": "reup.findTouchedFile",
        "title": "Reup: Find Sessions by Touched File",
        "icon": "$(references)"
      },
      {
        "command": "reup.showAllProjects",
        "title": "Reup: Show Sessions from All Projects",
        "icon": "$(globe)"
      },
      {
        "command": "reup.showWorkspaceOnly",
        "title": "Reup: Show Only This Workspace",
        "icon": "$(folder-active)"
      },
      {
        "command": "reup.openSessionDetail",
        "title": "Open Resume Card",
        "icon": "$(preview)"
      },
      {
        "command": "reup.tree.copySessionId",
        "title": "Copy Session ID",
        "icon": "$(copy)"
      },
      {
        "command": "reup.tree.copyHandoff",
        "title": "Copy Handoff",
        "icon": "$(clippy)"
      },
      {
        "command": "reup.tree.editAlias",
        "title": "Edit Session Alias",
        "icon": "$(edit)"
      },
      {
        "command": "reup.tree.editTags",
        "title": "Edit Session Tags",
        "icon": "$(tag)"
      },
      {
        "command": "reup.tree.toggleArchive",
        "title": "Archive / Unarchive Session",
        "icon": "$(archive)"
      },
      {
        "command": "reup.tree.resumeSession",
        "title": "Resume Session",
        "icon": "$(play)"
      },
      {
        "command": "reup.tree.revealProjectFolder",
        "title": "Reveal Project Folder",
        "icon": "$(folder-opened)"
      }
    ],
    "configuration": {
      "title": "Reup",
      "properties": {
        "reup.includeArchived": {
          "type": "boolean",
          "default": false,
          "description": "Include archived sessions in Reup's VS Code views."
        },
        "reup.countRepositorySessions": {
          "type": "boolean",
          "default": true,
          "description": "Count sessions from the rest of the repository in the Sessions view badge and the status indicator. Turn this off to make the indicator track the open folder alone; the Rest of Repository group stays visible either way."
        },
        "reup.sessionScope": {
          "type": "string",
          "enum": [
            "workspace",
            "all"
          ],
          "enumDescriptions": [
            "Show only sessions recorded in this window's workspace folders.",
            "Show sessions from every local project, grouped by workspace and elsewhere."
          ],
          "default": "workspace",
          "description": "Which sessions Reup's Sessions view, dashboard, and status indicator cover. 'Reup: Resume Session' and Deep search stay global either way. With no folder open, Reup shows all projects."
        },
        "reup.refreshMode": {
          "type": "string",
          "enum": [
            "manual",
            "watch",
            "interval"
          ],
          "default": "watch",
          "description": "Controls refresh while the Reup view is visible. Watch follows Claude and Git state; interval refreshes every 20 seconds; manual refreshes only on request."
        },
        "reup.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the compact Reup active/attention indicator while the cockpit is visible."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "reup.openDashboard",
          "when": "view == reup.sessions",
          "group": "navigation@0"
        },
        {
          "command": "reup.showAllProjects",
          "when": "view == reup.sessions && reup.hasWorkspaceRoots && reup.sessionScope == workspace",
          "group": "navigation@1"
        },
        {
          "command": "reup.showWorkspaceOnly",
          "when": "view == reup.sessions && reup.hasWorkspaceRoots && reup.sessionScope == all",
          "group": "navigation@1"
        },
        {
          "command": "reup.resumeHere",
          "when": "view == reup.sessions",
          "group": "navigation@2"
        },
        {
          "command": "reup.resumeSession",
          "when": "view == reup.sessions",
          "group": "navigation@3"
        },
        {
          "command": "reup.searchSessions",
          "when": "view == reup.sessions",
          "group": "navigation@4"
        },
        {
          "command": "reup.findTouchedFile",
          "when": "view == reup.sessions",
          "group": "navigation@5"
        },
        {
          "command": "reup.refreshSessions",
          "when": "view == reup.sessions",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "reup.openSessionDetail",
          "when": "view == reup.sessions && viewItem == reupSession",
          "group": "inline"
        },
        {
          "command": "reup.tree.resumeSession",
          "when": "view == reup.sessions && viewItem == reupSession",
          "group": "inline@2"
        },
        {
          "command": "reup.tree.copySessionId",
          "when": "view == reup.sessions && viewItem == reupSession",
          "group": "navigation"
        },
        {
          "command": "reup.tree.copyHandoff",
          "when": "view == reup.sessions && viewItem == reupSession",
          "group": "navigation@2"
        },
        {
          "command": "reup.tree.editAlias",
          "when": "view == reup.sessions && (viewItem == reupSession || viewItem == reupSessionActive)",
          "group": "navigation@3"
        },
        {
          "command": "reup.tree.editTags",
          "when": "view == reup.sessions && (viewItem == reupSession || viewItem == reupSessionActive)",
          "group": "navigation@4"
        },
        {
          "command": "reup.tree.toggleArchive",
          "when": "view == reup.sessions && viewItem == reupSession",
          "group": "navigation@5"
        },
        {
          "command": "reup.tree.revealProjectFolder",
          "when": "view == reup.sessions && viewItem == reupProject",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "reup": [
        {
          "id": "reup.sessions",
          "name": "Sessions",
          "icon": "media/reup.svg"
        },
        {
          "id": "reup.inspector",
          "name": "Session Inspector",
          "type": "webview",
          "icon": "media/reup.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "reup.sessions",
        "contents": "[Open Reup Dashboard](command:reup.openDashboard)\\n\\nNo Claude Code sessions were found.\\n[Refresh Reup](command:reup.refreshSessions)",
        "when": "!reup.hasSessions && !reup.hasLoadError"
      },
      {
        "view": "reup.sessions",
        "contents": "No Claude Code sessions were recorded in this workspace.\\n[Show sessions from all projects](command:reup.showAllProjects)\\n[Resume any session](command:reup.resumeSession)",
        "when": "reup.hasSessions && !reup.hasWorkspaceSessions && reup.sessionScope == workspace && !reup.hasLoadError"
      },
      {
        "view": "reup.sessions",
        "contents": "Reup could not read local session data.\\n[Show diagnostics](command:reup.diagnostics)",
        "when": "reup.hasLoadError"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reup",
          "title": "Reup",
          "icon": "media/reup.svg"
        }
      ]
    }
  },
  "scripts": {
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "generate:marketplace": "node scripts/generate-marketplace-assets.mjs",
    "compile": "npm run generate:brand && npm run generate:marketplace && tsc --noEmit && node esbuild.mjs",
    "package": "npm run compile",
    "install:local": "node scripts/install-local.mjs",
    "package:vsix": "npm run compile && node scripts/package-vsix.mjs",
    "smoke:host": "npm run compile && node scripts/run-smoke.mjs",
    "watch": "node esbuild.mjs --watch"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "sharp": "^0.35.2",
    "typescript": "^5.0.0"
  }
}
