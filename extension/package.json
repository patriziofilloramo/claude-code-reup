{
  "name": "swoop-vscode",
  "displayName": "Swoop for Claude Code",
  "description": "Find, understand, and safely resume Claude Code sessions across every project.",
  "version": "0.1.24",
  "publisher": "swoop-local",
  "private": true,
  "icon": "media/swoop-brand.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/patriziofilloramo/claude-code-swoop.git"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "sessions",
    "resume",
    "dashboard"
  ],
  "galleryBanner": {
    "color": "#101315",
    "theme": "dark"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onCommand:swoop.diagnostics",
    "onCommand:swoop.focusCockpit",
    "onCommand:swoop.openSessionDetail",
    "onCommand:swoop.openDashboard",
    "onCommand:swoop.refreshSessions",
    "onCommand:swoop.resumeHere",
    "onCommand:swoop.resumeSession",
    "onCommand:swoop.searchSessions",
    "onCommand:swoop.tree.copyHandoff",
    "onCommand:swoop.tree.copySessionId",
    "onCommand:swoop.tree.editAlias",
    "onCommand:swoop.tree.editTags",
    "onCommand:swoop.tree.resumeSession",
    "onCommand:swoop.tree.revealProjectFolder",
    "onCommand:swoop.tree.toggleArchive",
    "onView:swoop.sessions",
    "onView:swoop.inspector"
  ],
  "contributes": {
    "commands": [
      {
        "command": "swoop.openDashboard",
        "title": "Swoop: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "swoop.diagnostics",
        "title": "Swoop: Diagnostics"
      },
      {
        "command": "swoop.focusCockpit",
        "title": "Swoop: Focus Workspace Cockpit"
      },
      {
        "command": "swoop.refreshSessions",
        "title": "Swoop: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "swoop.resumeHere",
        "title": "Swoop: Resume Here",
        "icon": "$(play)"
      },
      {
        "command": "swoop.resumeSession",
        "title": "Swoop: Resume Session",
        "icon": "$(history)"
      },
      {
        "command": "swoop.searchSessions",
        "title": "Swoop: Search Sessions",
        "icon": "$(search)"
      },
      {
        "command": "swoop.openSessionDetail",
        "title": "Open Resume Card",
        "icon": "$(preview)"
      },
      {
        "command": "swoop.tree.copySessionId",
        "title": "Copy Session ID",
        "icon": "$(copy)"
      },
      {
        "command": "swoop.tree.copyHandoff",
        "title": "Copy Handoff",
        "icon": "$(clippy)"
      },
      {
        "command": "swoop.tree.editAlias",
        "title": "Edit Session Alias",
        "icon": "$(edit)"
      },
      {
        "command": "swoop.tree.editTags",
        "title": "Edit Session Tags",
        "icon": "$(tag)"
      },
      {
        "command": "swoop.tree.toggleArchive",
        "title": "Archive / Unarchive Session",
        "icon": "$(archive)"
      },
      {
        "command": "swoop.tree.resumeSession",
        "title": "Resume Session",
        "icon": "$(play)"
      },
      {
        "command": "swoop.tree.revealProjectFolder",
        "title": "Reveal Project Folder",
        "icon": "$(folder-opened)"
      }
    ],
    "configuration": {
      "title": "Swoop",
      "properties": {
        "swoop.includeArchived": {
          "type": "boolean",
          "default": false,
          "description": "Include archived sessions in Swoop's VS Code views."
        },
        "swoop.refreshMode": {
          "type": "string",
          "enum": [
            "manual",
            "watch",
            "interval"
          ],
          "default": "watch",
          "description": "Controls refresh while the Swoop view is visible. Watch follows Claude and Git state; interval refreshes every 20 seconds; manual refreshes only on request."
        },
        "swoop.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the compact Swoop active/attention indicator while the cockpit is visible."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "swoop.openDashboard",
          "when": "view == swoop.sessions",
          "group": "navigation@0"
        },
        {
          "command": "swoop.resumeHere",
          "when": "view == swoop.sessions",
          "group": "navigation@1"
        },
        {
          "command": "swoop.resumeSession",
          "when": "view == swoop.sessions",
          "group": "navigation@2"
        },
        {
          "command": "swoop.searchSessions",
          "when": "view == swoop.sessions",
          "group": "navigation@3"
        },
        {
          "command": "swoop.refreshSessions",
          "when": "view == swoop.sessions",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "swoop.openSessionDetail",
          "when": "view == swoop.sessions && viewItem == swoopSession",
          "group": "inline"
        },
        {
          "command": "swoop.tree.resumeSession",
          "when": "view == swoop.sessions && viewItem == swoopSession",
          "group": "inline@2"
        },
        {
          "command": "swoop.tree.copySessionId",
          "when": "view == swoop.sessions && viewItem == swoopSession",
          "group": "navigation"
        },
        {
          "command": "swoop.tree.copyHandoff",
          "when": "view == swoop.sessions && viewItem == swoopSession",
          "group": "navigation@2"
        },
        {
          "command": "swoop.tree.editAlias",
          "when": "view == swoop.sessions && (viewItem == swoopSession || viewItem == swoopSessionActive)",
          "group": "navigation@3"
        },
        {
          "command": "swoop.tree.editTags",
          "when": "view == swoop.sessions && (viewItem == swoopSession || viewItem == swoopSessionActive)",
          "group": "navigation@4"
        },
        {
          "command": "swoop.tree.toggleArchive",
          "when": "view == swoop.sessions && viewItem == swoopSession",
          "group": "navigation@5"
        },
        {
          "command": "swoop.tree.revealProjectFolder",
          "when": "view == swoop.sessions && viewItem == swoopProject",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "swoop": [
        {
          "id": "swoop.sessions",
          "name": "Sessions",
          "icon": "media/swoop.svg"
        },
        {
          "id": "swoop.inspector",
          "name": "Session Inspector",
          "type": "webview",
          "icon": "media/swoop.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "swoop.sessions",
        "contents": "[Open Swoop Dashboard](command:swoop.openDashboard)\\n\\nNo Claude Code sessions were found.\\n[Refresh Swoop](command:swoop.refreshSessions)",
        "when": "!swoop.hasSessions && !swoop.hasLoadError"
      },
      {
        "view": "swoop.sessions",
        "contents": "Swoop could not read local session data.\\n[Show diagnostics](command:swoop.diagnostics)",
        "when": "swoop.hasLoadError"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "swoop",
          "title": "Swoop",
          "icon": "media/swoop.svg"
        }
      ]
    }
  },
  "scripts": {
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "generate:marketplace": "node scripts/generate-marketplace-assets.mjs",
    "compile": "npm run generate:brand && npm run generate:marketplace && tsc --noEmit && node esbuild.mjs",
    "package": "npm run compile",
    "install:local": "node scripts/install-local.mjs",
    "package:vsix": "npm run compile && node scripts/package-vsix.mjs",
    "smoke:host": "npm run compile && node scripts/run-smoke.mjs",
    "watch": "node esbuild.mjs --watch"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "sharp": "^0.35.2",
    "typescript": "^5.0.0"
  }
}
