{
  "name": "@patriziofilloramo/reup",
  "version": "0.6.1",
  "description": "Find, monitor, and resume local Claude Code sessions across projects.",
  "type": "module",
  "bin": {
    "reup": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": {
    "name": "Patrizio Filloramo",
    "url": "https://github.com/patriziofilloramo"
  },
  "homepage": "https://github.com/patriziofilloramo/claude-code-reup#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patriziofilloramo/claude-code-reup.git"
  },
  "bugs": {
    "url": "https://github.com/patriziofilloramo/claude-code-reup/issues"
  },
  "keywords": [
    "claude-code",
    "session-manager",
    "developer-tools",
    "cli",
    "terminal",
    "productivity",
    "local-first"
  ],
  "files": [
    "dist/",
    "DISCLAIMER.md",
    "LICENSE",
    "PRIVACY.md",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "build:client": "node scripts/build-client.mjs",
    "build:extension": "npm run compile --prefix extension",
    "check:version": "node scripts/check-version-sync.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "package:extension": "npm run package:vsix --prefix extension",
    "postbuild": "npm run build:client && node scripts/copy-assets.mjs && node -e \"try{require('fs').chmodSync('dist/index.js',0o755)}catch(e){}\"",
    "dev": "tsc --watch",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"extension/**/*.{ts,mjs,json,md}\" \"docs/**/*.{html,css,md}\" \"Documents/**/*.md\" \"*.md\" \"*.config.js\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"extension/**/*.{ts,mjs,json,md}\" \"docs/**/*.{html,css,md}\" \"Documents/**/*.md\" \"*.md\" \"*.config.js\" \".github/**/*.yml\"",
    "install:cli": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1",
    "install:extension": "npm run install:local --prefix extension",
    "lint": "eslint src tests scripts extension/src extension/scripts extension/*.mjs",
    "lint:fix": "eslint src tests extension/src extension/*.mjs --fix",
    "start": "node dist/index.js",
    "pretest": "npm run build:client",
    "release:check": "node scripts/release-gate.mjs",
    "release:extension:check": "node scripts/check-vsix.mjs",
    "release:installers": "node scripts/build-installers.mjs",
    "release:local": "node scripts/build-release.mjs",
    "release:package:check": "node scripts/check-package.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "test": "vitest run",
    "test:extension-host": "npm run smoke:host --prefix extension",
    "test:watch": "vitest",
    "uninstall:cli": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-local.ps1",
    "version:major": "npm version major --no-git-tag-version && npm run sync:version",
    "version:minor": "npm version minor --no-git-tag-version && npm run sync:version",
    "version:patch": "npm version patch --no-git-tag-version && npm run sync:version",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint"
    ],
    "*.{css,html}": "prettier --write",
    "*.{md,json,yml}": "prettier --write"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "clipboardy": "^4.0.0",
    "hono": "^4.0.0",
    "ink": "^5.0.0",
    "react": "^18.0.0",
    "which": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/which": "^3.0.4",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8",
    "ws": "^8.21.0",
    "yauzl": "^3.4.0"
  }
}
