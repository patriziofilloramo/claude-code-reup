{
  "name": "claude-code-swoop",
  "version": "0.1.0",
  "description": "Session manager for Claude Code — TUI + Web",
  "type": "module",
  "bin": {
    "swoop": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:client": "node scripts/build-client.mjs",
    "build:extension": "npm run compile --prefix extension",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "package:extension": "npm run package:vsix --prefix extension",
    "postbuild": "npm run build:client && node scripts/copy-assets.mjs && node -e \"try{require('fs').chmodSync('dist/index.js',0o755)}catch(e){}\"",
    "dev": "tsc --watch",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"extension/**/*.{ts,mjs,json,md}\" \"Documents/**/*.md\" \"*.md\" \"*.config.js\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"extension/**/*.{ts,mjs,json,md}\" \"Documents/**/*.md\" \"*.md\" \"*.config.js\" \".github/**/*.yml\"",
    "lint": "eslint src tests extension/src extension/*.mjs",
    "lint:fix": "eslint src tests extension/src extension/*.mjs --fix",
    "start": "node dist/index.js",
    "pretest": "npm run build:client",
    "test": "vitest run",
    "test:extension-host": "npm run smoke:host --prefix extension",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "clipboardy": "^4.0.0",
    "hono": "^4.0.0",
    "ink": "^5.0.0",
    "react": "^18.0.0",
    "which": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/which": "^3.0.4",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
