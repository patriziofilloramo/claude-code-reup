{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Reup VS Code Extension",
      "type": "shell",
      "command": "npm run compile",
      "options": {
        "cwd": "${workspaceFolder}/extension"
      },
      "problemMatcher": "$tsc",
      "group": "build",
      "presentation": {
        "clear": true,
        "panel": "dedicated",
        "reveal": "silent"
      }
    },
    {
      "label": "Install Reup VS Code Extension Locally",
      "type": "shell",
      "command": "npm run install:extension",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Build Reup Installer Packages (release:installers)",
      "detail": "Runs the full validated release pipeline (tests, extension host smoke test, npm audit) before packaging. Takes several minutes.",
      "type": "shell",
      "command": "npm run release:installers",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Install Reup CLI Locally (install.ps1)",
      "detail": "Verifies and installs the Windows package built from the current clean commit into an isolated reup-dev directory, including cmd/PowerShell and Git Bash launchers.",
      "type": "shell",
      "command": "npm run install:cli",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Uninstall Reup CLI Locally (uninstall.ps1)",
      "detail": "Validates the isolated reup-dev install's ownership marker, then removes only its matching runtime and PATH entry.",
      "type": "shell",
      "command": "npm run uninstall:cli",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "panel": "dedicated",
        "reveal": "always"
      }
    }
  ]
}
